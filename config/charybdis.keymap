#include <behaviors/num_word.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/* Global defaults */

#define REQUIRE_PRIOR_IDLE_MS 150
#define QUICK_TAP_MS 175
#define NUM 2
#define SMART_NUM &smart_num NUM 0
#define CANCEL    &kp K_CANCEL            // Cancel caps-word & auto-layers.

/ {
    behaviors {
        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <6 7 8 9 18 19 5 15 16 25 27 26 28 29 17 35>;
            require-prior-idle-ms = <300>;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <13 14 2 0 1 3 4 12 11 10 20 21 22 23 24>;
            require-prior-idle-ms = <300>;
        };

        copy_cut: copy_cut {
            compatible = "zmk,behavior-tap-dance";
            label = "COPY_CUT";
            #binding-cells = <0>;
            bindings = <&kp LC(C)>, <&kp LC(X)>;
        };

        lshift_cap: lshift_cap {
            compatible = "zmk,behavior-tap-dance";
            label = "LSHIFT_CAP";
            #binding-cells = <0>;
            bindings = <&kp LSHIFT>, <&caps_word>;
        };

        com_sem: com_sem {
            compatible = "zmk,behavior-mod-morph";
            label = "COM_SEM";
            bindings = <&kp COMMA>, <&kp SEMICOLON>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        dot_col: dot_col {
            compatible = "zmk,behavior-mod-morph";
            label = "DOT_COL";
            bindings = <&kp PERIOD>, <&kp COLON>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        exc_qmk: exc_qmk {
            compatible = "zmk,behavior-mod-morph";
            label = "EXC_QMK";
            bindings = <&kp EXCL>, <&kp QMARK>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        bac_del: bac_del {
            compatible = "zmk,behavior-mod-morph";
            label = "BAC_DEL";
            bindings = <&kp BACKSPACE>, <&kp DEL>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            keep-mods = <(MOD_RSFT)>;
        };

        rshift_cap: rshift_cap {
            compatible = "zmk,behavior-tap-dance";
            label = "RSHIFT_CAP";
            #binding-cells = <0>;
            bindings = <&kp RIGHT_SHIFT>, <&caps_word>;
        };

        ltm: ltm {
            compatible = "zmk,behavior-hold-tap";
            label = "LTM";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            hold-trigger-on-release;
            require-prior-idle-ms = <0>;
        };

        hmsl: hmsl {
            compatible = "zmk,behavior-hold-tap";
            label = "HMSL";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <6 7 8 9 18 19 33 34 5 15 25 16 17 35 26 27 28 29>;
            require-prior-idle-ms = <100>;
        };

        hmsr: hmsr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMSR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <28 32 31 30 24 23 22 20 21 10 0 1 12 2 11 13 3 4 14>;
            require-prior-idle-ms = <100>;
        };

        lpar_less: lpar_less {
            compatible = "zmk,behavior-mod-morph";
            label = "LPAR_LESS";
            bindings = <&kp LEFT_PARENTHESIS>, <&kp LESS_THAN>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        rpar_greater: rpar_greater {
            compatible = "zmk,behavior-mod-morph";
            label = "RPAR_GREATER";
            bindings = <&kp RIGHT_PARENTHESIS>, <&kp GREATER_THAN>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        slash_bslash: slash_bslash {
            compatible = "zmk,behavior-mod-morph";
            label = "SLASH_BSLASH";
            bindings = <&kp SLASH>, <&kp BACKSLASH>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ltm2: ltm2 {
            compatible = "zmk,behavior-hold-tap";
            label = "LTM2";
            bindings = <&mo>, <&bac_del>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            hold-trigger-on-release;
            require-prior-idle-ms = <150>;
        };

        num_dance: num_dance {
            compatible = "zmk,behavior-tap-dance";
            label = "ZMK_TAP_DANCE";
            #binding-cells = <0>;
            bindings = <&bac_del>, <&num_word 2>;
        };

        smart_num: smart_num {
            compatible = "zmk,behavior-hold-tap";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            #binding-cells = <2>;
            bindings = <&mo>, <&num_dance>;
        };

        tsr: tsr {
            compatible = "zmk,behavior-hold-tap";
            label = "TSR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            flavor = "hold-preferred";
            hold-trigger-on-release;
            require-prior-idle-ms = <0>;
        };
    };

    combos {
        compatible = "zmk,combos";

        ESC_COMBO {
            bindings = <&gresc>;
            key-positions = <1 0>;
        };

        FIND_COMBOS {
            bindings = <&kp LC(F)>;
            key-positions = <20 2>;
        };

        SAVE_COMBOS {
            bindings = <&kp LC(S)>;
            key-positions = <20 12>;
        };

        win_copy {
            bindings = <&copy_cut>;
            key-positions = <20 22>;
        };

        SELECT_ALL_COMBOS {
            bindings = <&kp LC(A)>;
            key-positions = <20 10>;
        };

        PASTE_COMBOS {
            bindings = <&kp LC(V)>;
            key-positions = <20 24>;
        };

        wm_12 {
            bindings = <&kp LA(LG(E))>;
            key-positions = <5 15>;
            layers = <4>;
        };

        wm_23 {
            bindings = <&kp LA(LG(T))>;
            key-positions = <15 25>;
            layers = <4>;
        };

        left_par {
            bindings = <&lpar_less>;
            key-positions = <16 17>;
            require-prior-idle-ms = <150>;
        };

        r_par {
            bindings = <&rpar_greater>;
            key-positions = <17 18>;
            require-prior-idle-ms = <150>;
        };

        l_br {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <27 26>;
            require-prior-idle-ms = <150>;
        };

        r_br {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <27 28>;
            require-prior-idle-ms = <150>;
        };

        plus {
            bindings = <&kp KP_PLUS>;
            key-positions = <6 16>;
            require-prior-idle-ms = <150>;
        };

        minus {
            bindings = <&kp MINUS>;
            key-positions = <16 26>;
            require-prior-idle-ms = <150>;
        };

        star {
            bindings = <&kp STAR>;
            key-positions = <7 17>;
            require-prior-idle-ms = <150>;
        };

        spl {
            bindings = <&slash_bslash>;
            key-positions = <17 27>;
        };

        and {
            bindings = <&kp AMPERSAND>;
            key-positions = <5 15>;
            require-prior-idle-ms = <150>;
        };

        or {
            bindings = <&kp PIPE>;
            key-positions = <15 25>;
        };

        equ {
            bindings = <&kp EQUAL>;
            key-positions = <8 18>;
            layers = <0 2>;
        };

        under_sc {
            bindings = <&kp UNDER>;
            key-positions = <28 18>;
        };

        grave_combos {
            bindings = <&kp GRAVE>;
            key-positions = <13 23>;
            require-prior-idle-ms = <150>;
        };

        at_combos {
            bindings = <&kp AT_SIGN>;
            key-positions = <1 11>;
            require-prior-idle-ms = <150>;
        };

        hash_combos {
            bindings = <&kp HASH>;
            key-positions = <2 12>;
            require-prior-idle-ms = <150>;
        };

        dollor_combos {
            bindings = <&kp DOLLAR>;
            key-positions = <3 13>;
            require-prior-idle-ms = <150>;
        };

        percent_combos {
            bindings = <&kp PERCENT>;
            key-positions = <11 21>;
            require-prior-idle-ms = <150>;
        };

        hat_combos {
            bindings = <&kp CARET>;
            key-positions = <12 22>;
            require-prior-idle-ms = <150>;
        };

        screenshot {
            bindings = <&kp LG(LC(LS(N4)))>;
            key-positions = <11 12 13 31>;
        };

        undo_com {
            bindings = <&kp LC(Z)>;
            key-positions = <20 21>;
        };

        cap {
            bindings = <&caps_word>;
            key-positions = <20 29>;
        };

        paste2 {
            bindings = <&kp LC(V)>;
            key-positions = <20 23>;
        };

        newtab {
            bindings = <&kp LC(T)>;
            key-positions = <13 20>;
            require-prior-idle-ms = <300>;
        };

        swith_position {
            bindings = <&tog 1>;
            key-positions = <24 25>;
        };

        find3 {
            bindings = <&kp LC(F)>;
            key-positions = <2 10>;
            require-prior-idle-ms = <300>;
        };

        save2 {
            bindings = <&kp LC(S)>;
            key-positions = <10 12>;
            require-prior-idle-ms = <300>;
        };

        func_spa1 {
            bindings = <&kp LC(SPACE)>;
            key-positions = <19 31>;
        };

        func_spa2 {
            bindings = <&kp LC(SPACE)>;
            key-positions = <31 10>;
        };

        enter_comb {
            bindings = <&kp ENTER>;
            key-positions = <29 28>;
        };

        tab_combo {
            bindings = <&mo 5>;
            key-positions = <30 31>;
        };

        mlclk {
            bindings = <&mkp LCLK>;
            key-positions = <6 7>;
        };

        mrclk {
            bindings = <&mkp RCLK>;
            key-positions = <7 8>;
        };
    };

    macros {
        mac_save: mac_save {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none>, <&macro_press>;

            label = "MAC_SAVE";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "ColemakDH";
            bindings = <
&kp Q         &kp W        &kp F          &kp P               &kp B         &kp J         &kp L                &kp U        &kp Y        &kp SQT
&hml LCTRL A  &hml LALT R  &hml LGUI S    &hmsl LEFT_SHIFT T  &kp G         &kp M         &hmsr RIGHT_SHIFT N  &hmr RGUI E  &hmr LALT I  &hmr RCTRL O
&kp Z         &kp X        &kp C          &kp D               &kp V         &kp K         &kp H                &com_sem     &dot_col     &exc_qmk
                           &ltm 4 ESCAPE  &ltm 2 SPACE        &ltm 3 TAB    &ltm 3 ENTER  &ltm2 2 0
            >;
        };

        qwert_layer {
            label = "QWERT";
            bindings = <
&kp Q         &kp W        &kp E          &kp R              &kp T         &kp Y         &kp U               &kp I        &kp O        &kp P
&hml LCTRL A  &hml LALT S  &hml LGUI D    &hml LEFT_SHIFT F  &kp G         &kp H         &hmr RIGHT_SHIFT J  &hmr RGUI K  &hmr LALT L  &hmr RCTRL SQT
&kp Z         &kp X        &kp C          &kp V              &kp B         &kp N         &kp M               &com_sem     &dot_col     &exc_qmk
                           &ltm 4 ESCAPE  &ltm 2 SPACE       &ltm 3 TAB    &ltm 3 ENTER  &ltm 2 BACKSPACE
            >;
        };

        num_layer {
            label = "NUM";
            bindings = <
&trans  &kp N7              &kp N8        &kp N9         &trans        &trans  &trans  &trans  &trans  &trans
&trans  &hml LALT NUMBER_4  &hml LGUI N5  &hml LSHFT N6  &kp N0        &trans  &trans  &trans  &trans  &trans
&trans  &kp N1              &kp N2        &kp N3         &kp PERIOD    &trans  &trans  &trans  &trans  &trans CANCEL
                            &trans        &trans         &trans        &trans
            >;
        };

        nav_layer {
            bindings = <
&trans  &trans          &kp UP_ARROW    &trans            &kp PG_UP    &kp HOME  &trans           &kp UP_ARROW          &trans           &trans
&trans  &hml LALT LEFT  &hml LCMD DOWN  &hml LSHFT RIGHT  &kp PG_DN    &kp END   &hmr RSHFT LEFT  &hmr RCMD DOWN_ARROW  &hmr RALT RIGHT  &trans
&trans  &trans          &trans          &trans            &trans       &trans    &trans           &trans                &trans           &trans
                        &trans          &trans            &trans       &trans    &trans
            >;

            label = "NAV";
        };

        fn_layer {
            bindings = <
&kp F12                &kp F7        &kp F8        &kp F9         &none     &kp LA(LG(D))  &none                   &kp C_VOLUME_UP     &none                &none
&hml LEFT_CONTROL F11  &hml LALT F4  &hml LCMD F5  &hml LSHFT F6  &none     &kp LA(LG(F))  &hmr RSHFT LG(LEFT)     &hmr RCMD C_VOL_DN  &hmr RALT LG(RIGHT)  &kp RCTRL
&kp F10                &kp F1        &kp F2        &kp F3         &none     &kp LA(LG(G))  &kp LA(LG(LEFT_ARROW))  &kp C_MUTE          &kp LA(LG(RIGHT))    &none
                                     &trans        &trans         &trans    &trans         &trans
            >;

            label = "FUN";
        };

        sys_layer {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_CLR     &trans  &trans  &trans  &trans  &trans
&trans        &trans        &trans        &trans        &bootloader    &trans  &trans  &trans  &trans  &trans
&trans        &trans        &trans        &trans        &trans         &trans  &trans  &trans  &trans  &trans
                            &trans        &trans        &trans         &trans  &trans
            >;

            label = "SYS";
        };
    };
};
